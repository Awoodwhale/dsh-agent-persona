{
  "name": "dsh-agent-persona",
  "version": "0.1.1",
  "description": "Workspace personas for DeepSeek Harness (DSH): create many system-prompt personas and scope each one by workspace path or session id (exact / prefix / regex / contains), managed from a Web settings page with Markdown editing and AI tuning.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/install.sh",
    "scripts/install.ps1",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "persona",
    "system-prompt",
    "workspace",
    "settings-panel"
  ],
  "author": "awoodwhale <woodwhale@qq.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awoodwhale/dsh-agent-persona.git"
  },
  "homepage": "https://github.com/awoodwhale/dsh-agent-persona#readme",
  "bugs": {
    "url": "https://github.com/awoodwhale/dsh-agent-persona/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run generate:remote && tsc -p tsconfig.json && esbuild src/client.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=lib/client.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node test/personas.test.mjs && node test/client-helpers.test.mjs && node scripts/generate-remote.mjs --check",
    "prepare": "npm run build",
    "generate:remote": "node scripts/generate-remote.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1",
    "react": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "types": "lib/index.d.ts"
}
